{
  "gate": {
    "required_tags": [
      "Environment",
      "CostCenter",
      "DataClassification",
      "Owner"
    ],
    "governance_tag_types": [
      "aws_kms_key",
      "aws_lambda_function",
      "aws_iam_role",
      "aws_s3_bucket",
      "aws_cloudwatch_log_group",
      "aws_sqs_queue",
      "aws_sns_topic",
      "aws_cloudwatch_metric_alarm",
      "aws_secretsmanager_secret",
      "aws_cognito_user_pool",
      "aws_apigatewayv2_api",
      "aws_apigatewayv2_stage",
      "aws_cloudwatch_event_rule"
    ],
    "required_classification_tags": [
      "DataSensitivity",
      "MissionCriticality",
      "InternetReachable",
      "AgencyScope",
      "OwnerRole",
      "Archetype"
    ],
    "taggable_types": [
      "aws_kms_key",
      "aws_lambda_function",
      "aws_iam_role",
      "aws_s3_bucket",
      "aws_cloudwatch_log_group",
      "aws_sqs_queue",
      "aws_sns_topic",
      "aws_cloudwatch_metric_alarm",
      "aws_secretsmanager_secret",
      "aws_cognito_user_pool",
      "aws_apigatewayv2_api",
      "aws_apigatewayv2_stage",
      "aws_cloudwatch_event_rule"
    ],
    "tls": {
      "minimum": "TLSv1.2_2021",
      "order": [
        "SSLv3",
        "TLSv1",
        "TLSv1_2016",
        "TLSv1.1_2016",
        "TLSv1.2_2018",
        "TLSv1.2_2019",
        "TLSv1.2_2021"
      ],
      "min_days_to_expiry": 30
    },
    "accessibility": {
      "fail_on": [
        "error"
      ]
    },
    "iam": {
      "github_oidc_audience": "sts.amazonaws.com",
      "github_oidc_subject_prefix": "repo:sam-aydlette/samaydlette.com:"
    },
    "identity": {
      "min_password_length": 14
    },
    "logging": {
      "min_retention_days": 365
    },
    "api": {
      "protected_route_prefixes": [
        "/api"
      ]
    },
    "log_access": {
      "log_buckets": [
        "samaydlette-com-logs",
        "samaydlette-com-cloudtrail"
      ],
      "readers": [
        {
          "reader": "role:github-actions-deploy-oidc",
          "actions": [
            "s3:GetObject"
          ],
          "resources": [
            "arn:aws:s3:::samaydlette-com-logs/cloudfront/*",
            "arn:aws:s3:::samaydlette-com-logs/AWSLogs/*/CloudFront/*"
          ],
          "basis": "CDS-TRC-ACL: the deploy summarizes the CloudFront access records into /.well-known/access-summary.json (scripts/build-access-summary.py; infrastructure/bootstrap/trust-access-logs.tf)",
          "decided_by": "Sam Aydlette",
          "decided_on": "2026-11-06"
        },
        {
          "reader": "role:github-actions-evidence-nightly-oidc",
          "actions": [
            "cloudtrail:LookupEvents"
          ],
          "resources": [
            "*"
          ],
          "basis": "DEC-195: the automated audit-log review reads the CloudTrail event history (scripts/audit-log-review.py; infrastructure/bootstrap/evidence-nightly.tf)",
          "decided_by": "Sam Aydlette",
          "decided_on": "2026-11-06"
        }
      ]
    }
  }
}
