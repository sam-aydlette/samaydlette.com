{
  "$schema": "./freshness-config.schema.json",
  "version": "1.0",
  "description": "Governed freshness windows for every output published under /.well-known/ (REQ-PUB-2, REQ-GOV-1). The single source for the maximum age of each artifact: scripts/build-trust-center.py, scripts/check-evidence-freshness.py and the evidence SLA watchdog (infrastructure/watchdog.tf and infrastructure/watchdog/) all read it, and each fails closed if it is missing or invalid. Signatures (.bundle), schemas and the human-readable .md renderings are published with the artifact they accompany and are covered through it.",
  "decided_by": "Operator",
  "decided_on": "2026-11-03",
  "review_by": "2027-11-03",
  "rationale": "Nightly evidence (the VDR, its trend and attestation) must be under 24 hours old, the reporting policy. The runtime signal and the nightly's status beacon get 26 hours: one daily (or twice-daily) run plus one late run. Artifacts regenerated only on a deploy, which is human-initiated and human-approved, get 30 days, the monthly continuous-monitoring cadence: older than that, the inventory has not been re-derived from live state within a reporting month. The operator-run independent corroboration gets the same 30 days.",
  "artifacts": [
    {
      "path": ".well-known/vdr-report.json",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "json",
        "field": "emitted_at"
      },
      "signed": true,
      "signature": ".well-known/vdr-report.bundle"
    },
    {
      "path": ".well-known/vdr-trend.json",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "json",
        "field": "updated_at"
      },
      "signed": true,
      "signature": ".well-known/vdr-trend.bundle"
    },
    {
      "path": ".well-known/vdr-report.json.intoto.jsonl",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "last_modified"
      },
      "signed": true,
      "note": "Provenance attestation; a DSSE envelope with no timestamp of its own, so the object's last-modified time is used."
    },
    {
      "path": ".well-known/vdr-detail-report.json",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "json",
        "field": "reportPeriod.to"
      },
      "signed": true,
      "signature": ".well-known/vdr-detail-report.bundle",
      "note": "CR26 Vulnerability Detail Report (VER-RPT-VDT), rebuilt from every VDR report."
    },
    {
      "path": ".well-known/vdr-accepted-vulnerabilities.json",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "json",
        "field": "reportPeriod.to"
      },
      "signed": true,
      "signature": ".well-known/vdr-accepted-vulnerabilities.bundle",
      "note": "CR26 Accepted Vulnerability Info (VER-RPT-AVI), rebuilt from every VDR report."
    },
    {
      "path": ".well-known/vdr-history.json",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "json",
        "field": "generatedAt"
      },
      "signed": true,
      "signature": ".well-known/vdr-history.bundle",
      "note": "CR26 historical vulnerability activity (VER-TFR-MRH; Class C SHOULD update at least every 14 days), rebuilt from every VDR report."
    },
    {
      "path": ".well-known/vdr-monthly.json",
      "cadence": "nightly",
      "max_age_hours": 24,
      "timestamp": {
        "source": "json",
        "field": "generatedAt"
      },
      "signed": true,
      "signature": ".well-known/vdr-monthly.bundle",
      "note": "Monthly vulnerability detection and response activity report, month to date (VER-TFR-MHR, VER-RPT-HLO, VER-RPT-PER), rebuilt from every VDR report."
    },
    {
      "path": ".well-known/vdr-non-machine-vv.json",
      "cadence": "operator",
      "max_age_hours": 2208,
      "timestamp": {
        "source": "json",
        "field": "verifiedAt"
      },
      "signed": true,
      "signature": ".well-known/vdr-non-machine-vv.bundle",
      "note": "Non-machine verification and validation (VDR-TFR-NMV): verifiedAt is the oldest verification in data/non-machine-resources.json, so the 92-day window (3 months) lapses with the first resource out of date. Republished nightly; the verification itself is the operator's."
    },
    {
      "path": ".well-known/vdr-status.json",
      "cadence": "nightly",
      "max_age_hours": 26,
      "timestamp": {
        "source": "json",
        "field": "finished_at"
      },
      "signed": false,
      "note": "The nightly's status beacon. Unsigned and not evidence; listed because the watchdog pages on its age. The nightly runs twice a day, so 26 hours means runs have been missed."
    },
    {
      "path": ".well-known/ksi-signal-runtime.json",
      "cadence": "runtime",
      "max_age_hours": 26,
      "timestamp": {
        "source": "json",
        "field": "emitted_at"
      },
      "signed": true,
      "note": "Signed in-band (provenance.attestation) by the runtime Lambda, which runs daily; 26 hours tolerates one late run."
    },
    {
