{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samaydlette.com/schemas/frr-records.schema.json",
  "title": "FedRAMP rule records (SDR-CSO-FRR)",
  "description": "One record per FedRAMP rule applicable to 20x Program Class C, with one of four statuses (Implemented, Simulated, Not Demonstrated, Not Applicable). scripts/_frr.py enforces this shape and what a schema cannot: the record set equals the applicable rules in the pinned corpus and every evidence reference resolves. Its claim check (--claims) additionally requires each status's supporting fields (a Simulated record's stand-in proof, the operator's approval of every stand-in and scope cut), which this schema leaves optional so that an unapproved proposal can be recorded and reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "basis",
    "records"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema": {
      "const": "frr-records/1"
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frr_id",
          "status",
          "implementation"
        ],
        "properties": {
          "frr_id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[A-Z]{3}-[A-Z]{3}$"
          },
          "status": {
            "enum": [
              "Implemented",
              "Simulated",
              "Not Demonstrated",
              "Not Applicable"
            ]
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "test",
                    "step",
                    "artifact",
                    "decision"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "not_applicable": {
            "type": "string",
            "minLength": 1,
            "description": "Why the rule does not apply (Not Applicable records only)."
          },
          "not_demonstrated": {
            "type": "string",
            "minLength": 1,
            "description": "Why the rule is not demonstrated: what is not built (Not Demonstrated records only)."
          },
          "may_rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Required on, and only on, MAY rules: why the provider did or didn't exercise the permission."
          },
          "simulated": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "counterparty",
              "how"
            ],
            "description": "The labelled stand-in a Simulated record's mechanism runs on. The claim check requires real and stand_in.",
            "properties": {
              "counterparty": {
                "enum": [
                  "assessor",
                  "fedramp",
                  "agency",
                  "incident-recipient",
                  "mail",
                  "sam-gov",
                  "personnel"
                ]
              },
              "how": {
                "type": "string",
                "minLength": 1
              },
              "real": {
                "type": "string",
                "minLength": 1,
                "description": "What is real: the mechanism and its inputs that are not stand-ins."
              },
              "stand_in": {
                "type": "string",
                "minLength": 1,
                "description": "What is simulated: the labelled stand-in input."
              }
            }
          },
          "stand_in_proof": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bad_input",
              "replaceable"
            ],
            "description": "Simulated records only: a test that a bad stand-in changes the result (required), and how a real input would replace the stand-in and what would have to change, citing a test where one exists.",
            "properties": {
              "bad_input": {
                "type": "string",
                "minLength": 1,
                "description": "A pytest node ID that feeds a bad stand-in and asserts a different outcome."
              },
              "replaceable": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "description": "How a real input would replace the stand-in, and what would have to change."
                  },
                  "test": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional: a pytest node ID that shows a real input enters the same mechanism; must resolve if given."
                  }
                }
              }
            }
          },
          "proposal": {
            "$ref": "#/$defs/signoff",
            "description": "Who proposed the stand-in or scope cut, and when."
          },
          "approval": {
            "allOf": [
              {
                "$ref": "#/$defs/signoff"
              },
              {
                "properties": {
                  "by": {
                    "const": "Sam Aydlette"
                  }
                }
              }
            ],
            "description": "The operator's approval of the stand-in or scope cut. Written only on his word."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "Implemented"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "not_applicable"
                    ]
                  },
                  {
                    "required": [
                      "not_demonstrated"
                    ]
                  },
                  {
                    "required": [
                      "stand_in_proof"
                    ]
                  },
                  {
                    "required": [
                      "proposal"
                    ]
                  },
                  {
                    "required": [
                      "approval"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "Simulated"
                }
              }
            },
            "then": {
              "required": [
                "evidence",
                "simulated"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "not_applicable"
                    ]
                  },
                  {
                    "required": [
                      "not_demonstrated"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "Not Demonstrated"
                }
              }
            },
            "then": {
              "required": [
                "not_demonstrated"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "not_applicable"
                    ]
                  },
                  {
                    "required": [
                      "simulated"
                    ]
                  },
                  {
                    "required": [
                      "stand_in_proof"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "Not Applicable"
                }
              }
            },
            "then": {
              "required": [
                "not_applicable"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "not_demonstrated"
                    ]
                  },
                  {
                    "required": [
                      "simulated"
                    ]
                  },
                  {
                    "required": [
                      "stand_in_proof"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "on"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
