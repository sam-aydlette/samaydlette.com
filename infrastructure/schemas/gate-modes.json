{
  "$schema": "./gate-modes.schema.json",
  "version": "2026-11-04.3",
  "description": "The mode each gate check runs in, and the decision behind it (REQ-GAT-1, REQ-GAT-4). The method's default is block. A detect-and-recover check publishes its failure, queues it and starts a recovery clock instead of stopping the run. Read by scripts/_gates.py, which fails the build on a missing decision field, a non-default mode with no reason or a lapsed review date, or an unrecorded check.",
  "method_reference": "website/research/vulnerability-evidence.html#gates",
  "checks": [
    {
      "check": "vdr.kev",
      "gate": "G1",
      "mode": "block",
      "method_default": "block",
      "reason": "Stricter than the method. G1 blocks every known-exploited finding, dispositioned or not, from the first evaluation; the method blocks only once the KEV due date has passed or when a new resource would deploy with one.",
      "decided_by": "Sam Aydlette",
      "decided_on": "2026-11-04",
      "review_by": "2027-11-04"
    },
    {"check": "vdr.top-impact-lev-irv", "gate": "G2", "mode": "block", "method_default": "block",
     "decided_by": "Sam Aydlette", "decided_on": "2026-11-04", "review_by": "2027-11-04"},
    {"check": "vdr.past-deadline", "gate": "G3", "mode": "block", "method_default": "block",
     "decided_by": "Sam Aydlette", "decided_on": "2026-11-04", "review_by": "2027-11-04"},
    {"check": "vuln-gate.unhandled", "gate": "G3", "mode": "block", "method_default": "block",
     "decided_by": "Sam Aydlette", "decided_on": "2026-11-04", "review_by": "2027-11-04"},
    {
      "check": "runtime-divergence.diverged",
      "gate": "G4",
      "mode": "block",
      "method_default": "block",
      "reason": "A deploy may proceed past a fresh divergence only with --allow-divergence and a stated reason, which the deploy log records (break-glass for a deploy that is itself the fix).",
      "decided_by": "Sam Aydlette",
      "decided_on": "2026-11-04",
      "review_by": "2027-11-04"
    },
