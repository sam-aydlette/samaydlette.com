      "decided_by": "Sam Aydlette",
      "decided_on": "2026-11-04",
      "review_by": "2027-11-04"
    },
    {
      "check": "runtime-divergence.observer-fault",
      "gate": "G7",
      "mode": "detect-and-recover",
      "method_default": "block",
      "reason": "The runtime evaluator could not reach a verdict: its signal is unreadable, stale, undated, degraded or has no divergence block. Blocking deploys on it would also block the deploy that repairs the evaluator. The fault is published in the runtime signal and queued by the trust center (runtime_unassessed, runtime_stale) with its opening time.",
