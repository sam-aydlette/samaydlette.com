    {"check": "vdr.coverage", "gate": "G7", "mode": "detect-and-recover", "method_default": "block",
     "reason": "An inventory component with no detection technique in the last month (VDR-TFR-PCD) is a gap in detection, not a vulnerability in what is deployed; blocking would also block the deploy that adds the detection. The gap becomes a process finding (VDR-CSO-FAV) with a clock and a deadline, published in the VDR until coverage returns.",
     "decided_by": "Sam Aydlette", "decided_on": "2026-11-05", "review_by": "2027-05-05",
     "confirmed_on": "2026-11-06", "drafted_by": "AI-drafted (Claude)"},
    {"check": "vdr.unresolved-component", "gate": "G7", "mode": "detect-and-recover", "method_default": "block",
     "reason": "A finding that resolves to no inventory component is rated at the fail-safe (internet-reachable, most sensitive) until it is resolved (VER-EVA-EIR); blocking would also block the inventory change that resolves it. The unresolved evaluation becomes a process finding (VDR-CSO-FAV) with a clock and a deadline until every finding resolves.",
     "decided_by": "Sam Aydlette", "decided_on": "2026-11-05", "review_by": "2027-05-05",
