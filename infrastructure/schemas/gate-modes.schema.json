{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-modes.schema.json",
  "title": "Gate-mode register",
  "description": "The mode each gate check runs in and the decision behind it (REQ-GAT-1, REQ-GAT-4). scripts/_gates.py enforces these rules and the cross-field ones (a non-default mode needs a reason and an unexpired review_by; every implemented check has exactly one entry) at build time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checks"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "method_reference": {"type": "string"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "gate", "mode", "method_default", "decided_by", "decided_on", "review_by"],
        "properties": {
          "check": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"},
          "gate": {"enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7"]},
          "mode": {"enum": ["block", "detect-and-recover"]},
          "method_default": {"const": "block"},
          "reason": {"type": "string", "minLength": 1},
          "decided_by": {"type": "string", "minLength": 1},
          "decided_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "review_by": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        },
        "if": {"properties": {"mode": {"const": "detect-and-recover"}}},
        "then": {"required": ["reason"]}
      }
    }
  }
}
