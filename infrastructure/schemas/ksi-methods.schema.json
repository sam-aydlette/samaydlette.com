{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samaydlette.com/schemas/ksi-methods.schema.json",
  "title": "KSI methods (FRC-CSX-VVK)",
  "description": "The mechanisms, beyond annotated OPA rules, that count as an automated method for a KSI. scripts/_ksi_methods.py enforces this shape and what a schema cannot: every KSI is in the catalog, every published artifact is freshness-governed, every check names a verifier it implements, and a stand-in method carries a stand_in_proof whose tests exist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "description", "rationale", "methods"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "ksi-methods/1"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "mechanism", "measure", "ksis", "input", "verifier"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "mechanism": {"type": "string", "minLength": 1},
          "measure": {"type": "string", "minLength": 1, "description": "One sentence: what the mechanism tests."},
          "ksis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^KSI-[A-Z]{3}-[A-Z]{3}$"}},
          "input": {"enum": ["real", "stand-in"]},
          "stand_in_proof": {
            "type": "object", "additionalProperties": false, "required": ["bad_input", "replaceable"],
            "description": "Required when input is stand-in (CLAUDE.md, proof-of-concept latitude): a test that feeds a bad stand-in and asserts a different result, and how a real input would replace the stand-in.",
            "properties": {
              "bad_input": {"type": "string", "pattern": "^tests/[^:]+\\.py::.+$"},
              "replaceable": {"type": "object", "additionalProperties": false, "required": ["statement"],
                              "properties": {"statement": {"type": "string", "minLength": 1},
                                             "test": {"type": "string", "pattern": "^tests/[^:]+\\.py::.+$"}}}
            }
          },
          "verifier": {
            "type": "object",
            "required": ["kind"],
            "oneOf": [
              {"additionalProperties": false, "required": ["kind", "artifact", "check"],
               "properties": {"kind": {"const": "published"}, "artifact": {"type": "string", "pattern": "^\\.well-known/[a-z0-9-]+\\.json$"},
                              "check": {"enum": ["audit-log-review", "recovery-exercise", "reconcile", "security-settings", "conformance", "inbox-simulation", "availability", "scn-evaluations", "security-review", "board-meeting", "cfo-review", "tabletop", "disclosure-drill", "phishing-drill", "incident-lessons", "incident-patterns", "security-txt"]}}},
              {"additionalProperties": false, "required": ["kind", "feeds"],
               "properties": {"kind": {"const": "vdr-feed"}, "feeds": {"type": "array", "minItems": 1, "items": {"enum": ["grype", "dependabot", "checkov", "tfsec", "codeql", "zap-api"]}}}},
              {"additionalProperties": false, "required": ["kind"],
               "properties": {"kind": {"enum": ["runtime-divergence", "plan-gate", "training"]}}}
            ]
          }
        }
      }
    }
  }
}
