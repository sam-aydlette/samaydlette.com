{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detection-feeds.schema.json",
  "title": "Detection feed requirements (G7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decided_by", "decided_on", "review_by", "rationale", "feeds"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "decided_by": {"type": "string", "minLength": 1},
    "decided_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "review_by": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rationale": {"type": "string", "minLength": 1},
    "feeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kev", "epss", "grype", "dependabot", "previous-vdr", "checkov", "tfsec"],
      "patternProperties": {
        "^[a-z-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_date"],
          "properties": {
            "max_age_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 8760},
            "source_date": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
