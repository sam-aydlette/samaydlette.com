{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samaydlette.com/schemas/operator-identities.schema.json",
  "title": "Operator identities (never quarantined by a machine)",
  "description": "The IAM users of the people who operate the system. scripts/_quarantine.py loads it fail-closed (any user is paged about only while it cannot be loaded) and infrastructure/bootstrap/quarantine-responder.tf denies the responder these users.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "description", "users", "rationale"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "operator-identities/1"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "source"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_+=,.@-]{1,128}$"},
          "kind": {"const": "iam-user"},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1}
  }
}
