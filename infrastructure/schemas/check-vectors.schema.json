{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed per-check CVSS vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "description",
    "vectors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vector",
          "rationale",
          "decided_by",
          "decided_on",
          "review_by"
        ],
        "properties": {
          "vector": {
            "type": "string",
            "pattern": "^CVSS:3\\.1/AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "drafted_by": {
            "type": "string"
          },
          "decided_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "decided_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "review_by": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
